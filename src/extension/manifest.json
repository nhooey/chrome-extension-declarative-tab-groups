{
  "manifest_version": 3,
  "name": "Declarative Tab Groups",
  "version": "0.1.0",
  "description": "Lets local programs set the exact tabs of a named tab group, through a native host, without taking focus.",
  "minimum_chrome_version": "126",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "incognito": "not_allowed"
}
